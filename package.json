{
  "name": "airline-control",
  "version": "1.0.0",
  "description": "A persistent, real-time airline operations management platform integrated with live flight simulation networks",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 src/server.js",
    "dev": "nodemon --exec \"node --max-old-space-size=4096\" src/server.js",
    "go": "node start.js",
    "db:pull": "node src/scripts/pullLocalDb.js",
    "db:sync": "node src/scripts/syncDb.js",
    "db:fix-maintenance-schema": "node src/scripts/fixRecurringMaintenanceSchema.js",
    "db:seed-aircraft": "node src/scripts/seedAircraft.js",
    "db:seed-historical-aircraft": "node src/scripts/seedHistoricalAircraft.js",
    "db:add-airships-combis": "node src/scripts/addAirshipsAndCombis.js",
    "db:seed-airports": "node src/scripts/seedAirports.js",
    "db:seed-major-airports": "node src/scripts/seedMajorAirports.js",
    "db:import-airports": "node src/scripts/importOurAirports.js",
    "db:seed-historical": "node src/scripts/seedHistoricalAirports.js",
    "db:update-airport-dates": "node src/scripts/updateAirportDates.js",
    "db:import-all": "node src/scripts/importAllAirports.js",
    "world:create": "node src/scripts/createWorld.js",
    "build:fir": "node scripts/build-fir-boundaries.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "airline",
    "management",
    "simulation",
    "vatsim",
    "real-time"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "mdb-reader": "^3.1.0",
    "morgan": "^1.10.0",
    "ngraph.graph": "^20.1.1",
    "ngraph.path": "^1.6.1",
    "nodemailer": "^8.0.0",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@turf/helpers": "^7.3.5",
    "@turf/union": "^7.3.5",
    "nodemon": "^3.0.2"
  }
}
