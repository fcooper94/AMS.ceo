# Set default behavior to automatically normalize line endings
* text=auto
# Force specific line endings for certain file types
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Handle Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
# Compressed assets are binary (never normalise line endings)
*.gz binary
